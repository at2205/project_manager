# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <username>, <password> and <cluster-host>. URL-encode special characters in the password.
# The database name (mini-project-manager) is created automatically on first write.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/mini-project-manager?retryWrites=true&w=majority

# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
